{
  "name": "side-stash",
  "version": "0.1.7",
  "description": "Save text, links, and images to a private side panel. Search, filter, and copy — all stored locally.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "publish:chrome:dry-run": "node scripts/publish-chrome.mjs --dry-run",
    "publish:chrome": "node scripts/publish-chrome.mjs",
    "release:chrome": "npm run zip && npm run publish:chrome",
    "zip:firefox": "wxt zip -b firefox",
    "dev:website": "vite website",
    "build:website": "vite build website",
    "deploy:website": "npm run build:website && npx wrangler pages deploy dist-website --project-name side-stash --branch main",
    "postinstall": "wxt prepare"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.2.2",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.16",
    "fflate": "^0.8.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
